# Copy to frontend/.env and fill in, then rebuild. These values are public keys
# (they end up in the built site), not secrets.

# Web Push certificate (public key):
# Firebase console > Project settings > Cloud Messaging > Web configuration > Generate key pair
VITE_FCM_VAPID_KEY=

# reCAPTCHA v3 site key for Firebase App Check:
# Firebase console > App Check > Apps > register the web app with reCAPTCHA v3
VITE_RECAPTCHA_SITE_KEY=

# Optional, development only: an App Check debug token registered in the console.
# Leave empty to have the browser print a new one to the console on first load.
VITE_APPCHECK_DEBUG_TOKEN=
