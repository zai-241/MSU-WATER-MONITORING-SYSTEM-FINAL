# Copy this file to .env and fill it in. Never commit .env or the key file.

# Path to the service-account key downloaded from
# Firebase console > Project settings > Service accounts > Generate new private key
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccount.json

# Realtime Database URL (same value as databaseURL in frontend/src/config/firebase.ts)
DATABASE_URL=https://msu-water-monitoring-system-default-rtdb.asia-southeast1.firebasedatabase.app

# Where a tapped push notification opens
APP_URL=https://msu-water-monitoring-system.web.app

# Set to false to run the evaluator without sending push notifications
PUSH_ENABLED=true
