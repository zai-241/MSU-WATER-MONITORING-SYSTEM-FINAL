{
  "rules": {
    ".read": false,
    ".write": false,
    "roles": {
      ".read": "auth != null",
      "$uid": {
        ".write": "root.child('roles').child(auth.uid).val() === 'admin' || (!root.child('roles').exists() && $uid === auth.uid)",
        ".validate": "newData.isString() && newData.val().matches(/^(admin|worker|viewer|device)$/)"
      }
    },
    "config": {
      ".read": "auth != null",
      ".write": "root.child('roles').child(auth.uid).val() === 'admin'",
      "lowLevelThreshold": {
        ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
      },
      "overflowThreshold": {
        ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
      },
      "minPh": {
        ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 14"
      },
      "maxPh": {
        ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 14"
      },
      "pumpMode": {
        ".validate": "newData.isString() && newData.val().matches(/^(auto|manual)$/)"
      },
      "nightWatchEnabled": {
        ".validate": "newData.isBoolean()"
      },
      "nightStartHour": {
        ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 23"
      },
      "nightEndHour": {
        ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 23"
      },
      "nightFastDropPercent": {
        ".validate": "newData.isNumber() && newData.val() >= 3 && newData.val() <= 100"
      },
      "nightSlowDropPercent": {
        ".validate": "newData.isNumber() && newData.val() >= 3 && newData.val() <= 100"
      },
      "nightWatchTanks": {
        "$tankId": {
          ".validate": "newData.isBoolean()"
        }
      }
    },
    "tanks": {
      ".read": "auth != null",
      "$tankId": {
        ".write": "root.child('roles').child(auth.uid).val() === 'admin' || root.child('roles').child(auth.uid).val() === 'device'",
        "pumpOn": {
          ".write": "root.child('roles').child(auth.uid).val() === 'worker' && data.parent().child('assignedWorker').val() === auth.uid && root.child('config').child('pumpControlLock').val() !== true",
          ".validate": "newData.isBoolean()"
        },
        "phLevel": {
          ".validate": "!newData.exists() || newData.isNumber()"
        },
        "waterLevel": {
          ".validate": "!newData.exists() || newData.isNumber()"
        },
        "capacityLiters": {
          ".validate": "!newData.exists() || (newData.isNumber() && newData.val() > 0)"
        },
        "calibrationUntil": {
          ".validate": "!newData.exists() || (newData.isNumber() && newData.val() <= now + 1860000)"
        },
        "maintenanceMode": {
          ".validate": "newData.isBoolean() && (root.child('roles').child(auth.uid).val() === 'admin' || newData.val() === data.val())"
        },
        "thresholds": {
          ".validate": "root.child('roles').child(auth.uid).val() === 'admin' && newData.hasChildren(['lowLevelThreshold', 'overflowThreshold', 'minPh', 'maxPh']) && newData.child('lowLevelThreshold').isNumber() && newData.child('overflowThreshold').isNumber() && newData.child('minPh').isNumber() && newData.child('maxPh').isNumber() && newData.child('lowLevelThreshold').val() >= 0 && newData.child('overflowThreshold').val() <= 100 && newData.child('lowLevelThreshold').val() < newData.child('overflowThreshold').val() && newData.child('minPh').val() >= 0 && newData.child('maxPh').val() <= 14 && newData.child('minPh').val() < newData.child('maxPh').val()",
          "$other": {
            ".validate": "$other === 'lowLevelThreshold' || $other === 'overflowThreshold' || $other === 'minPh' || $other === 'maxPh'"
          }
        },
        "levelCalPoints": {
          ".validate": "root.child('roles').child(auth.uid).val() === 'admin' && newData.hasChildren(['0', '1'])",
          "$i": {
            ".validate": "$i.matches(/^1?[0-9]$/) && newData.hasChildren(['depthM', 'volts']) && newData.child('depthM').isNumber() && newData.child('depthM').val() >= 0 && newData.child('volts').isNumber() && newData.child('volts').val() >= 0.3 && newData.child('volts').val() <= 3.25",
            "$other": {
              ".validate": "$other === 'depthM' || $other === 'volts'"
            }
          }
        },
        "calibrationLive": {
          ".validate": "!newData.exists() || newData.hasChildren(['voltage', 'heightM', 'percent'])"
        },
        "controllerOffline": {
          ".write": "root.child('roles').child(auth.uid).exists()",
          ".validate": "newData.isBoolean()"
        }
      }
    },
    "history": {
      ".read": "auth != null",
      "tanks": {
        "$tankId": {
          ".write": "root.child('roles').child(auth.uid).val() === 'admin' || root.child('roles').child(auth.uid).val() === 'device'",
          ".indexOn": [
            "timestamp"
          ]
        }
      }
    },
    "logs": {
      ".read": "auth != null",
      ".write": "root.child('roles').child(auth.uid).val() === 'admin'",
      ".indexOn": [
        "timestamp"
      ],
      "$id": {
        ".write": "root.child('roles').child(auth.uid).exists() && (!data.exists() || root.child('roles').child(auth.uid).val() === 'admin')",
        "tankId": {
          ".validate": "newData.isString()"
        }
      }
    },
    "notifications": {
      ".read": "auth != null",
      ".indexOn": [
        "timestamp"
      ],
      "$notifId": {
        ".write": "(root.child('roles').child(auth.uid).val() === 'admin' || root.child('roles').child(auth.uid).val() === 'worker') && (newData.exists() || root.child('roles').child(auth.uid).val() === 'admin')",
        "acknowledgedByUid": {
          ".validate": "newData.val() === auth.uid || newData.val() === data.val()"
        }
      }
    },
    "userState": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "system": {
      ".read": "auth != null"
    },
    "presence": {
      ".read": "root.child('roles').child(auth.uid).val() === 'admin'",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid",
        "connections": {
          "$connectionId": {
            ".validate": "newData.hasChildren(['since', 'app']) && newData.child('since').isNumber() && newData.child('app').isString() && newData.child('app').val().matches(/^(web|android)$/)",
            "$other": { ".validate": "$other === 'since' || $other === 'app'" }
          }
        },
        "lastSeen": { ".validate": "newData.isNumber() && newData.val() <= now" },
        "$other": { ".validate": false }
      }
    }
  }
}
